{:paths ["src"]
 :deps {ring/ring-jetty-adapter {:mvn/version "1.15.4"}
        ;; Dependencia LOCAL al módulo common/ (no se descarga de internet).
        ;; ~ repositorio "path" de Composer. Malli llega de forma transitiva.
        app/common {:local/root "../common"}
        ;; Routing HTTP (~ Symfony Routing). Misma librería que Penpot.
        metosin/reitit-core {:mvn/version "0.9.1"}
        metosin/reitit-ring {:mvn/version "0.9.1"}
        ;; JSON request/response (Penpot usa Transit; nosotros JSON por simplicidad).
        cheshire/cheshire {:mvn/version "5.13.0"}}

 ;; Alias de desarrollo (~ "scripts" de desarrollo en composer.json).
 ;; Añade nREPL (servidor de REPL en red) y cider-nrepl (middleware para que
 ;; el editor —Calva en Cursor/VSCode— tenga autocompletado, ir a definición,
 ;; etc.). La carpeta extra "dev" solo está en el classpath en desarrollo.
 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                cider/cider-nrepl {:mvn/version "0.57.0"}
                ;; REPL de terminal "de verdad": historial, flechas, autocierre
                ;; de paréntesis y Ctrl+C que cancela la línea (no mata la JVM).
                ;; Misma versión que usa Penpot.
                com.bhauman/rebel-readline {:mvn/version "0.1.5"}}
   :main-opts ["-m" "dev-main"]}}}
